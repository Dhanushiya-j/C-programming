#include <stdio.h>
int ismax(int arr[],int n)
{int max,i;
    max=arr[0];
    for(i=0;i<n;i++)
    {
        if(max<arr[i])
        {
            max=arr[i];
        }
    }
    return max;
}
int ismin(int arr[],int n)
{int min,i;
    min=arr[0];
    for(i=0;i<n;i++)
    {
        if(min>arr[i])
        {
            min=arr[i];
        }
    }
    return min;
}
void main()
{
    int n,arr[50],i;
    printf("enter size:");
    scanf("%d",&n);
    for(i=0;i<n;i++)
    {
        printf("element [%d]:",i);
        scanf("%d",&arr[i]);
        
    }
    printf("max element :%d",ismax(arr,n));
    printf("min element :%d",ismin(arr,n));
    
}
